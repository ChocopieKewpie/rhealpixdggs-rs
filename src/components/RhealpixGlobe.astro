---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const configuredTiles = import.meta.env.PUBLIC_RHEALPIX_PMTILES_URL?.trim();
const configuredGridTiles = import.meta.env.PUBLIC_RHEALPIX_GRID_PMTILES_URL?.trim();
const tilesPath = configuredTiles || `${base}data/rhealpix-land-r5.pmtiles`;
const gridTilesPath =
  configuredGridTiles || `${base}data/rhealpix-land-r5-grid.pmtiles`;
const polarPath = `${base}data/rhealpix-polar-overlay.geojson`;
---

<div
  class="rhp-globe"
  data-rhp-globe
  data-tiles={tilesPath}
  data-grid-tiles={gridTilesPath}
  data-polar={polarPath}
  data-mode="compacted"
>
  <div
    class="rhp-globe__map"
    data-rhp-globe-map
    role="region"
    aria-label="Interactive globe comparing compacted and uncompacted resolution-5 rHEALPix land coverage"
  ></div>
  <div class="rhp-globe__loading" data-rhp-globe-status aria-live="polite">
    Loading visible map tiles…
  </div>
  <div class="rhp-globe__hint" data-rhp-globe-hint>
    Drag to rotate · zoom in and select a compacted cell · switch views to compare the hierarchy
  </div>
  <div class="rhp-globe__toolbar">
    <div class="rhp-globe__toggle" role="group" aria-label="Land-grid representation">
      <button type="button" aria-pressed="true" data-rhp-globe-mode="compacted">
        Compacted
      </button>
      <button type="button" aria-pressed="false" data-rhp-globe-mode="uncompacted">
        Uncompacted r5
      </button>
    </div>
    <div
      class="rhp-globe__legend"
      data-rhp-globe-compact-legend
      aria-label="Compacted cell resolution colours"
    >
      <span>Stored resolution</span>
      <ol>
        <li><i style="--swatch: #efb366"></i>1</li>
        <li><i style="--swatch: #e7955d"></i>2</li>
        <li><i style="--swatch: #d46f68"></i>3</li>
        <li><i style="--swatch: #9e668f"></i>4</li>
        <li><i style="--swatch: #46b9ad"></i>5</li>
      </ol>
    </div>
    <div class="rhp-globe__raw-summary" data-rhp-globe-raw-summary hidden>
      <strong>109,396</strong>
      <span>resolution-5 cells</span>
    </div>
  </div>
  <noscript>
    <p class="rhp-globe__fallback">Enable JavaScript to explore the interactive globe.</p>
  </noscript>
</div>

<script>
  type MapLibraries = {
    maplibregl: typeof import('maplibre-gl');
  };

  const activeGlobes = new WeakMap<HTMLElement, import('maplibre-gl').Map>();
  const initialisingGlobes = new WeakSet<HTMLElement>();
  let librariesPromise: Promise<MapLibraries> | undefined;

  function loadMapLibraries(): Promise<MapLibraries> {
    librariesPromise ??= Promise.all([import('maplibre-gl'), import('pmtiles')]).then(
      ([maplibregl, { Protocol }]) => {
        const protocol = new Protocol();
        maplibregl.addProtocol('pmtiles', protocol.tile);
        return { maplibregl };
      },
    );
    return librariesPromise;
  }

  const compactColour = [
    'match',
    ['get', 'resolution'],
    1,
    '#efb366',
    2,
    '#e7955d',
    3,
    '#d46f68',
    4,
    '#9e668f',
    5,
    '#46b9ad',
    '#46b9ad',
  ] as import('maplibre-gl').ExpressionSpecification;

  function popupContent(cell: unknown, resolution: unknown): HTMLElement {
    const content = document.createElement('div');
    content.className = 'rhp-globe-popup';
    const label = document.createElement('span');
    label.textContent = 'rHEALPix cell';
    const identifier = document.createElement('strong');
    identifier.textContent = String(cell ?? 'Unknown');
    const detail = document.createElement('small');
    detail.textContent = `Compacted at resolution ${String(resolution ?? '—')}`;
    content.append(label, identifier, detail);
    return content;
  }

  async function initialiseGlobe(root: HTMLElement): Promise<void> {
    if (activeGlobes.has(root)) return;

    const container = root.querySelector<HTMLElement>('[data-rhp-globe-map]');
    const status = root.querySelector<HTMLElement>('[data-rhp-globe-status]');
    const hint = root.querySelector<HTMLElement>('[data-rhp-globe-hint]');
    const compactLegend = root.querySelector<HTMLElement>(
      '[data-rhp-globe-compact-legend]',
    );
    const rawSummary = root.querySelector<HTMLElement>('[data-rhp-globe-raw-summary]');
    const modeButtons = root.querySelectorAll<HTMLButtonElement>('[data-rhp-globe-mode]');
    const tilePath = root.dataset.tiles;
    const gridTilePath = root.dataset.gridTiles;
    const polarPath = root.dataset.polar;
    if (!container || !tilePath || !gridTilePath || !polarPath) return;

    const archiveUrl = new URL(tilePath, window.location.href).href;
    const gridArchiveUrl = new URL(gridTilePath, window.location.href).href;
    const polarUrl = new URL(polarPath, window.location.href).href;
    try {
      const { maplibregl } = await loadMapLibraries();
      const map = new maplibregl.Map({
        container,
        center: [168, -24],
        zoom: 0.65,
        minZoom: 0,
        maxZoom: 6,
        pitch: 0,
        attributionControl: false,
        canvasContextAttributes: { antialias: true },
        style: {
          version: 8,
          projection: { type: 'globe' },
          sky: {
            'atmosphere-blend': [
              'interpolate',
              ['linear'],
              ['zoom'],
              0,
              1,
              5,
              0.8,
              7,
              0,
            ],
          },
          light: {
            anchor: 'map',
            color: '#e7f7ff',
            intensity: 0.4,
            position: [1.5, 90, 65],
          },
          sources: {},
          layers: [
            {
              id: 'ocean',
              type: 'background',
              paint: { 'background-color': '#102b45' },
            },
          ],
        },
      });

      activeGlobes.set(root, map);

      // MapLibre's global `idle` event waits for every requested tile and
      // animation to settle. A globe may therefore be usable well before
      // `idle` fires (and continuous interaction can postpone it indefinitely).
      // Reveal the working map independently from background tile streaming.
      function revealMap(): void {
        root.classList.add('is-ready');
        if (status) status.hidden = true;
      }

      map.addControl(
        new maplibregl.NavigationControl({ showCompass: true, showZoom: true }),
        'top-right',
      );
      map.addControl(new maplibregl.GlobeControl(), 'top-right');
      map.addControl(
        new maplibregl.AttributionControl({
          compact: true,
          customAttribution: 'Grid: rhealpixdggs · Coastline: Natural Earth',
        }),
        'bottom-right',
      );

      function addTileLayers(): void {
        map.addSource('rhealpixTiles', {
          type: 'vector',
          url: `pmtiles://${archiveUrl}`,
        });
        map.addSource('polarOverlay', { type: 'geojson', data: polarUrl });
        map.addLayer({
          id: 'compact-overview-fill',
          type: 'fill',
          source: 'rhealpixTiles',
          'source-layer': 'compact_overview',
          maxzoom: 2,
          paint: {
            'fill-color': compactColour,
            'fill-opacity': 0.79,
          },
        });
        map.addLayer({
          id: 'polar-compact-fill',
          type: 'fill',
          source: 'polarOverlay',
          filter: ['==', ['get', 'kind'], 'compact'],
          paint: {
            'fill-color': compactColour,
            'fill-opacity': 0.79,
          },
        });
        map.addLayer({
          id: 'compact-overview-grid',
          type: 'line',
          source: 'rhealpixTiles',
          'source-layer': 'compact_overview',
          minzoom: 1,
          maxzoom: 2,
          paint: {
            'line-color': '#ecfbff',
            'line-opacity': 0.34,
            'line-width': 0.5,
          },
        });
        map.addLayer({
          id: 'compact-cell-fill',
          type: 'fill',
          source: 'rhealpixTiles',
          'source-layer': 'compact_cells',
          minzoom: 2,
          paint: {
            'fill-color': compactColour,
            'fill-opacity': 0.79,
          },
        });
        map.addLayer({
          id: 'compact-cell-grid',
          type: 'line',
          source: 'rhealpixTiles',
          'source-layer': 'compact_cells',
          minzoom: 2,
          paint: {
            'line-color': '#ecfbff',
            'line-opacity': [
              'interpolate',
              ['linear'],
              ['zoom'],
              2,
              0.48,
              4,
              0.78,
            ],
            'line-width': [
              'interpolate',
              ['linear'],
              ['zoom'],
              2,
              0.58,
              4,
              1.05,
            ],
          },
        });
        map.addLayer({
          id: 'polar-compact-grid',
          type: 'line',
          source: 'polarOverlay',
          filter: ['==', ['get', 'kind'], 'compact'],
          paint: {
            'line-color': '#ecfbff',
            'line-opacity': 0.68,
            'line-width': 0.8,
          },
        });
        map.addLayer({
          id: 'polar-uncompacted-grid',
          type: 'line',
          source: 'polarOverlay',
          filter: ['==', ['get', 'kind'], 'raw_grid'],
          minzoom: 2,
          layout: { visibility: 'none' },
          paint: {
            'line-color': '#eafcff',
            'line-opacity': 0.72,
            'line-width': 0.8,
          },
        });
        map.addLayer({
          id: 'coastline',
          type: 'line',
          source: 'rhealpixTiles',
          'source-layer': 'coast',
          paint: {
            'line-color': '#f7fcff',
            'line-opacity': 0.9,
            'line-width': [
              'interpolate',
              ['linear'],
              ['zoom'],
              0,
              0.8,
              3,
              1.7,
            ],
          },
        });
        map.addLayer({
          id: 'polar-coastline',
          type: 'line',
          source: 'polarOverlay',
          filter: ['==', ['get', 'kind'], 'coast'],
          paint: {
            'line-color': '#f7fcff',
            'line-opacity': 0.9,
            'line-width': 1.2,
          },
        });
      }

      function ensureUncompactedLayer(): void {
        if (map.getLayer('uncompacted-grid')) {
          map.setLayoutProperty('uncompacted-grid', 'visibility', 'visible');
          return;
        }
        if (status) {
          status.hidden = false;
          status.textContent = 'Streaming the visible resolution-5 grid…';
        }
        map.addSource('rhealpixGridTiles', {
          type: 'vector',
          url: `pmtiles://${gridArchiveUrl}`,
        });
        map.addLayer(
          {
            id: 'uncompacted-grid',
            type: 'line',
            source: 'rhealpixGridTiles',
            'source-layer': 'raw_grid',
            minzoom: 2,
            paint: {
              'line-color': '#eafcff',
              'line-opacity': [
                'interpolate',
                ['linear'],
                ['zoom'],
                2,
                0.28,
                4,
                0.72,
              ],
              'line-width': [
                'interpolate',
                ['linear'],
                ['zoom'],
                2,
                0.42,
                4,
                1.05,
              ],
            },
          },
          'coastline',
        );
        // registration completes the UI transition while visible PMTiles
        // continue to arrive and render in the background.
        map.once('render', revealMap);
        window.setTimeout(revealMap, 1_500);
      }

      function setMode(mode: 'compacted' | 'uncompacted'): void {
        const compacted = mode === 'compacted';
        root.dataset.mode = mode;
        modeButtons.forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.rhpGlobeMode === mode),
          );
        });
        if (compactLegend) compactLegend.hidden = !compacted;
        if (rawSummary) rawSummary.hidden = compacted;
        if (hint) {
          hint.textContent = compacted
            ? 'Drag to rotate · zoom in and select a compacted cell · switch views to compare the hierarchy'
            : 'Drag to rotate · zoom to level 2 or closer to reveal the complete resolution-5 grid';
        }

        for (const layer of [
          'compact-overview-grid',
          'compact-cell-grid',
          'polar-compact-grid',
        ]) {
          map.setLayoutProperty(layer, 'visibility', compacted ? 'visible' : 'none');
        }
        map.setLayoutProperty(
          'polar-uncompacted-grid',
          'visibility',
          compacted ? 'none' : 'visible',
        );
        if (compacted) {
          if (map.getLayer('uncompacted-grid')) {
            map.setLayoutProperty('uncompacted-grid', 'visibility', 'none');
          }
        } else {
          ensureUncompactedLayer();
        }
        for (const layer of [
          'compact-overview-fill',
          'compact-cell-fill',
          'polar-compact-fill',
        ]) {
          map.setPaintProperty(layer, 'fill-opacity', compacted ? 0.79 : 0.62);
          map.setPaintProperty(layer, 'fill-color', compacted ? compactColour : '#46b9ad');
        }
      }

      function inspectCompactedCell(
        event: import('maplibre-gl').MapLayerMouseEvent,
      ): void {
        if (root.dataset.mode !== 'compacted') return;
        const feature = event.features?.[0];
        if (!feature) return;
        new maplibregl.Popup({ closeButton: false, offset: 9 })
          .setLngLat(event.lngLat)
          .setDOMContent(
            popupContent(feature.properties?.cell, feature.properties?.resolution),
          )
          .addTo(map);
      }

      map.on('load', () => {
        addTileLayers();
        modeButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const mode = button.dataset.rhpGlobeMode;
            if (mode === 'compacted' || mode === 'uncompacted') setMode(mode);
          });
        });
        map.on('click', 'compact-cell-fill', inspectCompactedCell);
        map.on('click', 'polar-compact-fill', inspectCompactedCell);
        map.on('mouseenter', 'compact-cell-fill', () => {
          map.getCanvas().style.cursor =
            root.dataset.mode === 'compacted' ? 'pointer' : '';
        });
        map.on('mouseleave', 'compact-cell-fill', () => {
          map.getCanvas().style.cursor = '';
        });
        map.on('mouseenter', 'polar-compact-fill', () => {
          map.getCanvas().style.cursor =
            root.dataset.mode === 'compacted' ? 'pointer' : '';
        });
        map.on('mouseleave', 'polar-compact-fill', () => {
          map.getCanvas().style.cursor = '';
        });
        // Do not wait for the map-wide `idle` event. Once the sources and
        // layers are registered the globe is interactive and MapLibre can
        // progressively paint each visible tile.
        revealMap();
      });
      map.on('error', (event) => {
        if (status) {
          status.hidden = false;
          status.textContent = 'The map tiles could not be loaded.';
        }
        console.error('rHEALPix globe:', event.error);
      });
    } catch (error) {
      if (status) status.textContent = 'This browser cannot display the interactive globe.';
      console.error('rHEALPix globe initialisation:', error);
    }
  }

  function initialiseGlobes(): void {
    document.querySelectorAll<HTMLElement>('[data-rhp-globe]').forEach((root) => {
      if (activeGlobes.has(root) || initialisingGlobes.has(root)) return;
      initialisingGlobes.add(root);
      void initialiseGlobe(root).finally(() => {
        initialisingGlobes.delete(root);
      });
    });
  }

  initialiseGlobes();
  document.addEventListener('astro:page-load', initialiseGlobes);
</script>
